# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=

# آیدی عددی تلگرام شما (اگر خالی باشد، ربات بعد از /start آیدی را به شما می‌گوید)
OWNER_ID=

# کلید Gemini از https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# اختیاری: پراکسی برای تلگرام (مثلاً socks5://127.0.0.1:1080 یا http://127.0.0.1:8080)
TELEGRAM_PROXY=
# اختیاری: پراکسی برای Gemini و بقیه درخواست‌ها
# HTTPS_PROXY=http://127.0.0.1:8080

# ساعت‌ها به وقت تهران
DAILY_REPORT_ENABLED=1
DAILY_REPORT_HOUR=22
REMINDER_HOUR=9

# اختیاری: مسیر دیتابیس و فونت نمودارها
# DB_PATH=data/ledger.db
# CHART_FONT_PATH=C:\Windows\Fonts\tahoma.ttf
